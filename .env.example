# Environment Variables Template
EXPEDIA_AD_PROJECT__SEED=42

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=expedia_ads
POSTGRES_USER=adtech
POSTGRES_PASSWORD=change_me_in_production

# Redis
REDIS_HOST=localhost
